  "commands": {
    "health_check": "curl https://gentlequest.onrender.com/api/health",
    "run_backend": "flask run --port 5055",
    "run_frontend": "cd ai_buddy_web && flutter run -d chrome",
    "run_tests": "pytest tests/ -v",
    "deploy": "git push origin main",
    "deploy_runbook": "python runbooks/deploy_production.py --execute",
    "check_freshness": "python scripts/check_doc_freshness.py --dir .brain/artifacts/synthesis/ -v",
    "validate_protocol": "python scripts/validate_protocol.py"
  },
  "verification": {
    "daily": [
      "health_check_200",
      "ci_green"
    ],
    "weekly": [
      "error_logs_review",
      "rate_limit_stats",
      "keep_alive_working"
    ],
    "monthly": [
      "tech_debt_update",
      "doc_freshness",
      "dependency_check"
    ],
    "quarterly": [
      "security_review",
      "secret_rotation",
      "crisis_hotline_verify",
      "full_doc_review"
    ]
  },
  "decision_authority": {
    "code_changes": {
      "authority": "any_developer",
      "approval": "pr_review"
    },
    "api_changes": {
      "authority": "backend_lead",
      "approval": "protocol_update"
    },
    "schema_changes": {
      "authority": "architect",
      "approval": "protocol_update"
    },
    "secret_changes": {
      "authority": "founder",
      "approval": "render_dashboard"
    },
    "deploy_production": {
      "authority": "any_with_access",
      "approval": "none"
    },
    "rollback": {
      "authority": "any_with_access",
      "approval": "none_emergency"
    },
    "protocol_changes": {
      "authority": "founder_only",
      "approval": "git_commit"
    }
