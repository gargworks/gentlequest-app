    "provider": "render",
    "region": "oregon",
    "health_endpoint": "/api/health",
    "ping_endpoint": "/api/ping"
  },
  "repository": {
    "path": "/Users/lokeshgarg/ai-mvp-backend",
    "vcs": "git",
    "remote": "origin",
    "branch": "main"
  },
  "stack": {
    "backend": {
      "language": "python",
      "version": "3.11",
      "framework": "flask",
      "framework_version": "3.0.x"
    },
    "frontend": {
      "framework": "flutter",
      "version": "3.x",
      "platform": "web"
    },
    "database": {
      "type": "postgresql",
      "version": "15+",
      "provider": "render"
    },
    "cache": {
      "type": "redis",
      "version": "7+",
      "provider": "external"
