  "retention": {
    "messages_days": 30,
    "sessions_days": 14,
    "analytics_days": 90,
    "error_logs_days": 14
  },
  "timeouts": {
    "ai_response_seconds": 30,
    "database_query_seconds": 5,
    "health_check_seconds": 10
  },
  "performance": {
    "target_response_time_ms": 500,
    "max_message_length": 10000,
    "max_context_messages": 20
