        "model": "gemini-1.5-flash"
      },
      {
        "name": "openai",
        "role": "fallback_1",
        "model": "gpt-4o-mini"
      },
      {
        "name": "perplexity",
        "role": "fallback_2",
        "model": "llama-3.1-sonar-small-128k-online"
      }
    ]
  },
  "endpoints": {
    "core": [
      {"path": "/api/health", "method": "GET", "purpose": "health_check", "rate_limit": null},
      {"path": "/api/ping", "method": "GET", "purpose": "keep_alive", "rate_limit": null},
      {"path": "/api/chat", "method": "POST", "purpose": "ai_chat", "rate_limit": "30/min"},
      {"path": "/api/chat_stream", "method": "GET", "purpose": "sse_streaming", "rate_limit": "120/min"},
      {"path": "/api/mood", "method": "POST", "purpose": "log_mood", "rate_limit": "120/min"},
      {"path": "/api/mood/history", "method": "GET", "purpose": "mood_history", "rate_limit": "120/min"},
      {"path": "/api/mood/analytics", "method": "GET", "purpose": "mood_analytics", "rate_limit": "120/min"},
      {"path": "/api/quests", "method": "GET", "purpose": "get_quests", "rate_limit": "120/min"},
      {"path": "/api/quests/complete", "method": "POST", "purpose": "complete_quest", "rate_limit": "120/min"},
      {"path": "/api/progress", "method": "GET", "purpose": "get_progress", "rate_limit": "120/min"},
      {"path": "/api/community/feed", "method": "GET", "purpose": "community_feed", "rate_limit": "120/min"},
      {"path": "/api/assessment/<type>", "method": "POST", "purpose": "self_assessment", "rate_limit": "120/min"}
    ],
    "community": [
      {"path": "/api/community/flags", "method": "GET", "purpose": "feature_flags"},
      {"path": "/api/community/reaction", "method": "POST", "purpose": "add_reaction"},
      {"path": "/api/community/report", "method": "POST", "purpose": "report_content"},
      {"path": "/api/community/post", "method": "POST", "purpose": "create_post"},
      {"path": "/api/community/post/<id>", "method": "DELETE", "purpose": "delete_post"}
    ],
    "admin": [
      {"path": "/api/brain/status", "method": "GET", "purpose": "brain_status"},
      {"path": "/api/brain/alert", "method": "POST", "purpose": "send_alert"},
      {"path": "/api/enterprise/status", "method": "GET", "purpose": "enterprise_status"},
      {"path": "/api/enterprise/metrics", "method": "GET", "purpose": "enterprise_metrics"}
    ],
    "total_count": 59
  },
  "secrets": {
    "required": [
      "SECRET_KEY",
      "DATABASE_URL",
      "GEMINI_API_KEY"
    ],
    "recommended": [
      "REDIS_URL",
      "OPENAI_API_KEY",
      "PPLX_API_KEY"
    ],
    "optional": [
      "SENTRY_DSN_BACKEND",
      "ADMIN_API_TOKEN"
    ],
    "storage": "render_dashboard",
    "never_commit": true
  },
  "rate_limits": {
    "global_per_day": 5000,
    "global_per_hour": 1000,
    "chat_per_minute": 120,
    "mood_per_minute": 120,
    "key_type": "session_id"
