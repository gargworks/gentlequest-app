
# Version Control
.git
.gitignore

# Dependencies
node_modules
.venv
venv
env
__pycache__
*.pyc
*.pyo

# Local Environment
.env
.env.local
.DS_Store

# Build Artifacts
build/
dist/
.next/

# IDEs
.vscode/
.idea/

# Flutter — narrow exclusions only.
# Wholesale `ai_buddy_web/` was here previously; that blocked the
# multi-stage Dockerfile's Stage 1 from accessing pubspec/lib/web/assets.
# Keep heavy build artifacts + platform-specific dirs out, let source in.
ai_buddy_web/.dart_tool/
ai_buddy_web/build/
ai_buddy_web/.pub/
ai_buddy_web/.packages
ai_buddy_web/android/
ai_buddy_web/ios/
ai_buddy_web/macos/
ai_buddy_web/linux/
ai_buddy_web/windows/
ai_buddy_web/test/
ai_buddy_web/integration_test/
ai_buddy_web/coverage/

# Large Data (Optional - Keep this if you have large local datasets)
data/

# Brain Logs & Archives (Don't deploy raw memory)
.brain/raw/
.brain/archive/
.brain/backups/
.brain-archive/

# Logs
logs/
*.log

# Huge Directories (Irrelevant to GentleQuest backend)
landing-page/
test_env/
scheduler_env/
# Exclude specific tools subdirectories (keep nucleus-hud for the HUD build)
tools/brain_analyze_sentiment/
tools/marketing-dashboard/
tools/omega/
tools/*.py
tools/registry.json

# Recursive Exclusions
**/.venv
**/venv
**/__pycache__
**/.DS_Store
