FROM python:3.9-slim

WORKDIR /app

# Install dependencies
COPY tools/marketing-dashboard/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Dashboard Code
COPY tools/marketing-dashboard/ /app/tools/marketing-dashboard/

# Copy Marketing Docs (Snapshot)
COPY docs/marketing/ /app/docs/marketing/

# Ensure secrets directory exists (even if empty, to prevent path errors)
RUN mkdir -p /app/secret

# Environment
ENV PYTHONUNBUFFERED=1
ENV PORT=8080

# Run
CMD ["python3", "tools/marketing-dashboard/server.py"]
