---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pageSlug: string; // e.g. "install", "api", "" for index
}

const { title, description, pageSlug } = Astro.props;

const siteUrl = 'https://docs.eidetic.works';
const canonical = pageSlug ? `${siteUrl}/${pageSlug}/` : `${siteUrl}/`;
const fullTitle = title === 'Docs' ? 'eidetic-daemon docs' : `${title} — eidetic-daemon docs`;
const ogImage = 'https://eidetic.works/og-eidetic-works.png';

// Sidebar nav definition — single source of truth.
const navGroups = [
  {
    label: 'Get started',
    items: [
      { href: '/', slug: '', label: 'Overview' },
      { href: '/install/', slug: 'install', label: 'Install' },
      { href: '/changelog/', slug: 'changelog', label: 'Changelog' },
    ],
  },
  {
    label: 'Reference',
    items: [
      { href: '/api/', slug: 'api', label: 'HTTP API' },
      { href: '/mcp/', slug: 'mcp', label: 'MCP tools' },
      { href: '/cli/', slug: 'cli', label: 'CLI flags' },
    ],
  },
  {
    label: 'Guides',
    items: [
      { href: '/recall/', slug: 'recall', label: 'nucleus_ask recipes' },
    ],
  },
  {
    label: 'Pricing',
    items: [
      { href: '/pro/', slug: 'pro', label: 'Pro tier' },
      { href: '/team/', slug: 'team', label: 'Team tier' },
    ],
  },
  {
    label: 'Policy',
    items: [
      { href: '/security/', slug: 'security', label: 'Security' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="eidetic-daemon docs" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@eidetic_works" />
  </head>

  <body>
    <nav class="topnav">
      <div class="topnav-inner">
        <a href="/" class="logo">
          <svg width="16" height="16" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="120" height="120" fill="#0a0a0a"/>
            <rect x="0.5" y="0.5" width="119" height="119" fill="none" stroke="#232830" stroke-width="1"/>
            <rect x="46" y="46" width="28" height="28" fill="#5eead4"/>
          </svg>
          EIDETIC WORKS
        </a>
        <span class="nav-tag">docs</span>
        <div class="topnav-links">
          <a href="https://eidetic.works">Landing</a>
          <a href="https://github.com/eidetic-works/eidetic-daemon">GitHub</a>
          <a href="https://eideticworks.gumroad.com/l/eidetic-pro">Pro</a>
        </div>
      </div>
    </nav>

    <div class="layout">
      <aside class="sidebar">
        {navGroups.map((group) => (
          <div class="sidebar-group">
            <div class="sidebar-label">{group.label}</div>
            <ul class="sidebar-nav">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class={item.slug === pageSlug ? 'active' : ''}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>

    <footer>
      <div class="footer-inner">
        <span>&copy; 2026 Eidetic Works</span>
        <div class="footer-links">
          <a href="https://github.com/eidetic-works/eidetic-daemon">GitHub</a>
          <a href="https://eidetic.works">eidetic.works</a>
          <a href="mailto:hi@eidetic.works">hi@eidetic.works</a>
        </div>
      </div>
    </footer>
  </body>
</html>
