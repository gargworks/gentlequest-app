"use client";

import React from 'react';

interface Props {
    isOpen: boolean;
    onConfirmSafe: () => void;
    reason?: string;
}

export default function NucleusCrisisModal({ isOpen, onConfirmSafe, reason = "Crisis Flag" }: Props) {
    if (!isOpen) return null;

    return (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
            {/* Backdrop */}
            <div className="absolute inset-0 bg-black/90 backdrop-blur-sm animate-fadeIn" />

            {/* Modal */}
            <div
                role="alertdialog"
                aria-modal="true"
                aria-labelledby="crisis-title"
                aria-describedby="crisis-desc"
                className="relative bg-black border border-red-500 shadow-[0_0_50px_rgba(255,0,0,0.3)] 
                   rounded-lg max-w-md w-full p-6 font-mono text-red-500 animate-slideUp"
            >
                <div className="flex items-center gap-3 mb-4 border-b border-red-500/30 pb-4">
                    <div className="text-3xl">⚠️</div>
                    <div>
                        <h2 id="crisis-title" className="text-xl font-bold text-red-400">SAFETY_INTERVENTION</h2>
                        <p className="text-xs text-red-500/60">TRIGGER: {reason}</p>
                    </div>
                </div>

                <p id="crisis-desc" className="mb-6 text-red-300">
                    We noticed a concerning pattern in your inputs. If you are in immediate distress:
                </p>

                <div className="space-y-4 mb-8">
                    <a href="tel:988" className="block p-4 border border-red-500/50 rounded bg-red-900/10 hover:bg-red-900/30 transition-colors text-center group">
                        <span className="block text-2xl font-bold text-white group-hover:text-red-300">CALL 988</span>
                        <span className="text-xs uppercase">Suicide & Crisis Lifeline</span>
                    </a>

                    <a href="tel:911" className="block p-4 border border-red-500/50 rounded bg-red-900/10 hover:bg-red-900/30 transition-colors text-center group">
                        <span className="block text-2xl font-bold text-white group-hover:text-red-300">CALL 911</span>
                        <span className="text-xs uppercase">Emergency Services</span>
                    </a>
                </div>

                <button
                    onClick={onConfirmSafe}
                    className="w-full py-3 border border-green-500/50 text-green-500 hover:bg-green-500/10 rounded font-bold transition-all"
                >
                    I_AM_SAFE_RIGHT_NOW
                </button>
            </div>
        </div>
    );
}
