
"use client";

import React from 'react';

export default function GenericCrisisModal({ isOpen, onClose }) {
    if (!isOpen) return null;

    return (
        <div style={{
            position: 'fixed', top: 0, left: 0, right: 0, bottom: 0,
            backgroundColor: 'rgba(0,0,0,0.5)',
            display: 'flex', alignItems: 'center', justifyContent: 'center'
        }}>
            <div style={{ backgroundColor: 'white', padding: '20px', borderRadius: '8px', maxWidth: '400px' }}>
                <h2 style={{ color: 'red' }}>Warning</h2>
                <p>If you are feeling unsafe, please seek help.</p>
                <button onClick={onClose} style={{ marginTop: '10px' }}>I understand</button>
            </div>
        </div>
    );
}
