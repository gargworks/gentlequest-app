{
    "triggers": [
        {
            "id": "strategy_to_architect",
            "event": "strategy_updated",
            "emitter": "strategist",
            "activates": [
                "architect",
                "synthesizer"
            ],
            "condition": "always"
        },
        {
            "id": "spec_to_dev",
            "event": "spec_ready_for_development",
            "emitter": "architect",
            "activates": [
                "developer"
            ],
            "condition": "always"
        },
        {
            "id": "code_to_critic",
            "event": "implementation_complete",
            "emitter": "developer",
            "activates": [
                "critic"
            ],
            "condition": "always"
        },
        {
            "id": "review_pass",
            "event": "review_approved",
            "emitter": "critic",
            "activates": [
                "synthesizer"
            ],
            "condition": "always"
        },
        {
            "id": "review_fail",
            "event": "review_blocked",
            "emitter": "critic",
            "activates": [
                "developer"
            ],
            "condition": "severity >= HIGH"
        },
        {
            "id": "market_intel",
            "event": "market_shift_detected",
            "emitter": "researcher",
            "activates": [
                "strategist"
            ],
            "condition": "always"
        },
        {
            "id": "founder_escalation",
            "event": "founder_decision_needed",
            "emitter": "*",
            "activates": [
                "synthesizer"
            ],
            "condition": "severity == CRITICAL"
        },
        {
            "id": "meta_optimization",
            "event": "meta_optimization_complete",
            "emitter": "synthesizer",
            "activates": [
                "*"
            ],
            "condition": "always"
        },
        {
            "id": "dogfood_retrospective",
            "event": "sprint_completed",
            "emitter": "*",
            "activates": [
                "synthesizer"
            ],
            "condition": "always",
            "action": "Prompt user for dogfood retrospective. Update test/dogfood_log.md with session ratings."
        }
    ]
}