---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

type Props = {
	currentSlug: string;
	tags?: string[];
	max?: number;
};

const { currentSlug, tags = [], max = 3 } = Astro.props;

// Fetch all blog posts and filter out any without required fields
const allPosts = (await getCollection('blog')).filter(
	(p) => p.data && p.data.pubDate && p.data.title
);

// Score posts by shared tags (exclude current post)
const scored = allPosts
	.filter((p) => p.id !== currentSlug)
	.map((p) => {
		const postTags = p.data.tags || [];
		const sharedTags = Array.isArray(tags) ? postTags.filter((t) => tags.includes(t)) : [];
		return { post: p, score: sharedTags.length };
	})
	.filter((p) => p.score > 0)
	.sort((a, b) => {
		if (b.score !== a.score) return b.score - a.score;
		const bDate = b.post.data.pubDate ? b.post.data.pubDate.valueOf() : 0;
		const aDate = a.post.data.pubDate ? a.post.data.pubDate.valueOf() : 0;
		return bDate - aDate;
	})
	.slice(0, max);

// If no shared-tag posts, fall back to newest posts
const related = scored.length > 0
	? scored.map((s) => s.post)
	: allPosts
			.filter((p) => p.id !== currentSlug)
			.sort((a, b) => {
				const bDate = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
				const aDate = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
				return bDate - aDate;
			})
			.slice(0, max);
---

{related.length > 0 && (
	<aside class="related-posts">
		<h2>Related posts</h2>
		<ul>
			{related.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="related-title">{post.data.title}</span>
						<span class="related-date">
							<FormattedDate date={post.data.pubDate} />
						</span>
					</a>
				</li>
			))}
		</ul>
	</aside>
)}

<style>
	.related-posts {
		margin: 2em 0;
		padding: 1.5em;
		background: rgb(var(--gray-light), 30%);
		border-radius: 12px;
	}
	.related-posts h2 {
		font-size: 1.25em;
		margin-bottom: 0.75em;
		color: rgb(var(--black));
	}
	.related-posts ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75em;
	}
	.related-posts li a {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		text-decoration: none;
		padding: 0.5em 0.75em;
		border-radius: 8px;
		transition: background 0.15s;
	}
	.related-posts li a:hover {
		background: rgb(var(--gray-light), 60%);
	}
	.related-title {
		font-weight: 600;
		color: rgb(var(--black));
		font-size: 0.95em;
		line-height: 1.3;
	}
	.related-date {
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
</style>
