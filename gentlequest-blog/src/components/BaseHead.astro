---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;

// GA4 Measurement ID (format G-XXXXXXXXXX).
// Populated from PUBLIC_GA_MEASUREMENT_ID at build time.
// NOTE: The operator must retrieve the actual Measurement ID value from
// GA4 Admin > Data Streams for property 516568186 and set it as
// PUBLIC_GA_MEASUREMENT_ID in the blog's .env. Do NOT fabricate a value.
// When unset, we emit a console.warn stub so the build stays green but the
// gap is visible in the browser console.
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
const GA_MEASUREMENT_ID_VALID =
	typeof GA_MEASUREMENT_ID === 'string' && /^G-[A-Z0-9]{6,}$/.test(GA_MEASUREMENT_ID);
// Backend URL for analytics beacon (cross-origin POST from blog → backend).
const BACKEND_URL = (import.meta.env.PUBLIC_BACKEND_URL as string) || 'https://gentlequest.onrender.com';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href={new URL(import.meta.env.BASE_URL + '/sitemap-index.xml', Astro.site)} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- GA4 gtag.js — Measurement ID from PUBLIC_GA_MEASUREMENT_ID (format G-XXXXXXXXXX).
     If unset/invalid, a console.warn stub keeps the build green and surfaces the gap. -->
{GA_MEASUREMENT_ID_VALID ? (
	<>
		<script
			is:inline
			async
			src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
		></script>
		<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				window.dataLayer.push(arguments);
			}
			window.gtag = gtag;
			gtag('js', new Date());
			gtag('config', GA_MEASUREMENT_ID);
		</script>
	</>
) : (
	<script is:inline>
		// PUBLIC_GA_MEASUREMENT_ID is unset or invalid — GA4 gtag.js not loaded.
		// Operator action required: set PUBLIC_GA_MEASUREMENT_ID (G-XXXXXXXXXX) in .env,
		// retrieved from GA4 Admin > Data Streams for property 516568186.
		window.gtag = function () {
			console.warn(
				'[GentleQuest] GA4 not configured — set PUBLIC_GA_MEASUREMENT_ID to a valid G-XXXXXXXXXX Measurement ID. Event dropped:',
				arguments
			);
		};
		console.warn(
			'[GentleQuest] PUBLIC_GA_MEASUREMENT_ID is unset or invalid — GA4 gtag.js not loaded. ' +
				'Operator: retrieve the Measurement ID from GA4 Admin > Data Streams for property 516568186 and set it in the blog .env.'
		);
	</script>
)}

<!-- GentleQuest activation-proof client helpers: UTM capture + dual-channel event beacon.
     sendBlogEvent fires BOTH gtag('event', ...) AND a POST to /api/analytics/log with
     the required X-Analytics-Consent: true header (backend rejects beacons without it). -->
<script is:inline define:vars={{ BACKEND_URL }}>
	(function () {
		// Capture UTM params once on load; stash on window.__gqUtm for CTA handlers.
		try {
			var params = new URLSearchParams(window.location.search);
			window.__gqUtm = {
				utm_source: params.get('utm_source') || null,
				utm_medium: params.get('utm_medium') || null,
				utm_campaign: params.get('utm_campaign') || null,
			};
		} catch (e) {
			window.__gqUtm = { utm_source: null, utm_medium: null, utm_campaign: null };
		}

		// Dual-channel event beacon: GA4 + backend /api/analytics/log.
		// The X-Analytics-Consent: true header is REQUIRED (backend rejects without it).
		window.sendBlogEvent = function (eventType, metadata) {
			metadata = metadata || {};
			if (typeof window.gtag === 'function') {
				try {
					window.gtag('event', eventType, metadata);
				} catch (e) {
					console.warn('[GentleQuest] gtag event failed:', e);
				}
			}
			try {
				fetch(BACKEND_URL + '/api/analytics/log', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'X-Analytics-Consent': 'true',
					},
					body: JSON.stringify({ event_type: eventType, metadata: metadata }),
				}).catch(function (e) {
					console.warn('[GentleQuest] analytics beacon failed:', e);
				});
			} catch (e) {
				console.warn('[GentleQuest] analytics beacon failed:', e);
			}
		};
	})();
</script>
