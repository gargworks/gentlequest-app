---
// Newsletter signup component for GentleQuest blog
// Posts to the GentleQuest backend API (no third-party service needed)
const BACKEND_URL = (import.meta.env.PUBLIC_BACKEND_URL as string) || 'https://app.gentlequest.app';
---

<section class="newsletter">
	<div class="newsletter-inner">
		<h3>Get the occasional GentleQuest letter</h3>
		<p>No spam, no streaks, no pressure. One thoughtful email every few weeks about ADHD, anxiety, and building a gentler relationship with yourself.</p>
		<form id="newsletter-form" data-backend={BACKEND_URL}>
			<input type="email" name="email" placeholder="your@email.com" required />
			<button type="submit">Subscribe</button>
		</form>
		<p id="newsletter-success" class="success-msg" style="display:none;">
			You're in. We'll send you something good soon.
		</p>
		<p id="newsletter-error" class="error-msg" style="display:none;">
			Something went wrong. Try again, or email us at support@gentlequest.app
		</p>
		<p class="privacy-note">We never share your email. Unsubscribe anytime.</p>
	</div>
</section>

<script>
	const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
	const success = document.getElementById('newsletter-success');
	const error = document.getElementById('newsletter-error');

	if (form) {
		const backendUrl = form.dataset.backend || 'https://app.gentlequest.app';
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement;
			const email = emailInput?.value?.trim();
			if (!email) return;
			try {
				const response = await fetch(`${backendUrl}/api/newsletter/subscribe`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email, source: 'blog' }),
				});
				if (response.ok) {
					form.style.display = 'none';
					success!.style.display = 'block';
					if (typeof gtag !== 'undefined') {
						gtag('event', 'newsletter_signup', {
							'event_category': 'engagement',
							'event_label': 'blog Newsletter'
						});
					}
				} else {
					error!.style.display = 'block';
				}
			} catch (err) {
				error!.style.display = 'block';
			}
		});
	}
</script>

<style>
	.newsletter {
		background: linear-gradient(135deg, #f5f0eb 0%, #ede4d9 100%);
		border-radius: 16px;
		padding: 2.5em 2em;
		margin: 3em 0;
		text-align: center;
	}
	.newsletter-inner {
		max-width: 480px;
		margin: 0 auto;
	}
	.newsletter h3 {
		font-size: 1.5rem;
		color: #2a2520;
		margin: 0 0 0.5em 0;
	}
	.newsletter p {
		color: #6b5d50;
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0 0 1.5em 0;
	}
	.newsletter form {
		display: flex;
		gap: 0.5em;
		margin-bottom: 0.75em;
	}
	.newsletter input[type="email"] {
		flex: 1;
		padding: 0.75em 1em;
		border: 1px solid #d4c9b8;
		border-radius: 8px;
		font-size: 1rem;
		background: white;
		color: #2a2520;
	}
	.newsletter input[type="email"]:focus {
		outline: none;
		border-color: #8b7355;
	}
	.newsletter button {
		padding: 0.75em 1.5em;
		background: #2a2520;
		color: white;
		border: none;
		border-radius: 8px;
		font-size: 1rem;
		cursor: pointer;
		transition: background 0.2s;
		white-space: nowrap;
	}
	.newsletter button:hover {
		background: #4a3f35;
	}
	.success-msg {
		color: #4a7c59 !important;
		font-weight: 600;
	}
	.error-msg {
		color: #c0392b !important;
	}
	.privacy-note {
		font-size: 0.8rem !important;
		color: #9b8d80 !important;
		margin-top: 0.5em !important;
	}
	@media (max-width: 480px) {
		.newsletter form {
			flex-direction: column;
		}
		.newsletter button {
			width: 100%;
		}
	}
</style>
