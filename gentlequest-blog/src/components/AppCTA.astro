---
// In-article CTA for GentleQuest app
// Placed mid-article and at end to drive click-through to the app
const variant = Astro.props.variant || 'end';
const ctaText = variant === 'mid'
  ? 'Try a 60-second check-in — no streaks, no judgment'
  : 'Start your first 60-second check-in';
---

<aside class={`app-cta app-cta--${variant}`}>
	<div class="app-cta-inner">
		<div class="app-cta-content">
			<p class="app-cta-tagline">GentleQuest</p>
			<h3 class="app-cta-heading">{ctaText}</h3>
			<p class="app-cta-subtitle">A gentle AI mood tracker for anxiety, stress, and burnout. No streaks. No guilt. Just small steps at your pace.</p>
			<div class="app-cta-buttons">
				<a
					href={`https://app.gentlequest.app/?ref=blog_cta_${variant}`}
					class="app-cta-btn app-cta-btn--primary"
					onclick={`if(typeof gtag!=='undefined'){gtag('event','cta_click',{event_category:'engagement',event_label:'blog_cta_${variant}',value:1})}`}
				>
					Start free check-in →
				</a>
				<a
					href={`https://play.google.com/store/apps/details?id=app.gentlequest.www&ref=blog_cta_${variant}`}
					class="app-cta-btn app-cta-btn--secondary"
					onclick={`if(typeof gtag!=='undefined'){gtag('event','cta_click',{event_category:'engagement',event_label:'blog_cta_${variant}_android',value:1})}`}
				>
					Get on Android
				</a>
			</div>
		</div>
	</div>
</aside>

<style>
	.app-cta {
		margin: 2.5em 0;
		border-radius: 16px;
		overflow: hidden;
		background: linear-gradient(135deg, #2a2520 0%, #3d3530 100%);
		color: #f5f0eb;
	}
	.app-cta--mid {
		margin: 2em 0;
		padding: 1.5em;
	}
	.app-cta--end {
		margin: 3em 0 1em 0;
		padding: 2em;
	}
	.app-cta-inner {
		max-width: 560px;
		margin: 0 auto;
		text-align: center;
	}
	.app-cta-tagline {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #c4a882;
		margin: 0 0 0.3em 0;
		font-weight: 600;
	}
	.app-cta-heading {
		font-size: 1.3rem;
		font-weight: 700;
		margin: 0 0 0.5em 0;
		line-height: 1.3;
		color: #f5f0eb;
	}
	.app-cta-subtitle {
		font-size: 0.9rem;
		line-height: 1.5;
		color: #b8a898;
		margin: 0 0 1.2em 0;
	}
	.app-cta-buttons {
		display: flex;
		gap: 0.6em;
		justify-content: center;
		flex-wrap: wrap;
	}
	.app-cta-btn {
		display: inline-block;
		padding: 0.7em 1.4em;
		border-radius: 8px;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s;
		white-space: nowrap;
	}
	.app-cta-btn--primary {
		background: #c4a882;
		color: #2a2520;
	}
	.app-cta-btn--primary:hover {
		background: #d4b892;
		transform: translateY(-1px);
	}
	.app-cta-btn--secondary {
		background: transparent;
		color: #f5f0eb;
		border: 1px solid #6b5d50;
	}
	.app-cta-btn--secondary:hover {
		background: rgba(255, 255, 255, 0.05);
		border-color: #8b7d70;
	}
	@media (max-width: 480px) {
		.app-cta-buttons {
			flex-direction: column;
		}
		.app-cta-btn {
			width: 100%;
		}
	}
</style>
