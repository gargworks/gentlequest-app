---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} GentleQuest. All rights reserved.
	<div class="footer-links">
		<a href="https://gentlequest.app">App</a>
		<a href="https://apps.apple.com/us/app/gentlequest-ai-mood-tracker/id6756537464">iOS</a>
		<a href="https://play.google.com/store/apps/details?id=app.gentlequest.www">Android</a>
		<a href="https://gentlequest.app/privacy">Privacy</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-top: 1em;
	}
	.footer-links a {
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.footer-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
