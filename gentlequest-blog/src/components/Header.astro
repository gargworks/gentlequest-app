---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://app.gentlequest.app/?ref=header_checkin_cta" target="_blank" rel="noopener">
				<span class="sr-only">GentleQuest app</span>
				<span class="app-link">60-second check-in</span>
			</a>
		</div>
	</nav>
</header>

<script is:inline>
	(function () {
		// GentleQuest activation-proof: header CTA impression + click instrumentation.
		// cta_id 'header_checkin_cta'. Copy/href swap happens in Task 7 — this task
		// ONLY adds event instrumentation; link text and href are unchanged.
		var headerCta = document.querySelector('header .social-links a');
		if (!headerCta) return;

		var impressionFired = false;
		function fireImpression() {
			if (impressionFired) return;
			impressionFired = true;
			try {
				window.sendBlogEvent('cta_impression', {
					cta_id: 'header_checkin_cta',
					landing_path: window.location.pathname,
					target_url: headerCta.href,
				});
			} catch (e) {
				console.warn('[GentleQuest] header cta_impression failed:', e);
			}
		}

		// IntersectionObserver: fire cta_impression once when header CTA enters viewport.
		if ('IntersectionObserver' in window) {
			var observer = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (entry) {
						if (entry.isIntersecting) {
							fireImpression();
							observer.disconnect();
						}
					});
				},
				{ threshold: 0.5 }
			);
			observer.observe(headerCta);
		} else {
			fireImpression();
		}

		// Click listener: fire cta_click before navigation, preserving utm_* params.
		headerCta.addEventListener('click', function () {
			try {
				window.sendBlogEvent('cta_click', Object.assign(
					{
						cta_id: 'header_checkin_cta',
						landing_path: window.location.pathname,
						target_url: headerCta.href,
					},
					window.__gqUtm || {}
				));
			} catch (e) {
				console.warn('[GentleQuest] header cta_click failed:', e);
			}
		});
	})();
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.app-link {
		font-weight: 600;
		font-size: 0.9rem;
		color: rgb(var(--accent));
	}
	@media (max-width: 720px) {
		.internal-links {
			display: flex;
			gap: 0;
		}
		.internal-links a {
			font-size: 0.8rem;
			padding: 1em 0.4em;
		}
		.app-link {
			font-size: 0.8rem;
		}
		h2 a {
			font-size: 0.85rem;
		}
	}
</style>
