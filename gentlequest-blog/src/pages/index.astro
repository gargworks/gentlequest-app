---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Progress, not pressure.</h1>
				<p class="tagline">
					A gentle AI mood tracker for anxiety, stress, and burnout. No streaks. No guilt. Just small steps at your pace.
				</p>
				<div class="cta-row">
					<a href="https://gentlequest.app/app?ref=hero_checkin_cta" class="cta-btn primary-btn">Start a private 60-second check-in — no streaks, no judgment</a>
					<div class="secondary-ctas">
						<a href="https://apps.apple.com/us/app/gentlequest-ai-mood-tracker/id6756537464" class="cta-btn secondary-btn store-link">Download for iOS</a>
						<a href="https://play.google.com/store/apps/details?id=app.gentlequest.www" class="cta-btn secondary-btn store-link">Get it on Google Play</a>
					</div>
				</div>
			</section>

			<section class="recent-posts">
				<h2>Recent posts</h2>
				{recentPosts.length > 0 ? (
					<ul>
						{recentPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h4 class="title">{post.data.title}</h4>
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									<p class="desc">{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty">Posts coming soon.</p>
				)}
				{posts.length > 4 && (
					<a href="/blog" class="see-all">See all posts →</a>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<script is:inline>
	(function () {
		// GentleQuest activation-proof: hero CTA impression + click instrumentation.
		// cta_id 'hero_checkin_cta' will be re-pointed to the check-in deep link in Task 7.
		var ctaRow = document.querySelector('.cta-row');
		if (!ctaRow) return;

		var impressionFired = false;
		function fireImpression(targetUrl) {
			if (impressionFired) return;
			impressionFired = true;
			try {
				window.sendBlogEvent('cta_impression', {
					cta_id: 'hero_checkin_cta',
					landing_path: window.location.pathname,
					target_url: targetUrl,
				});
			} catch (e) {
				console.warn('[GentleQuest] hero cta_impression failed:', e);
			}
		}

		// IntersectionObserver: fire cta_impression once when hero CTA enters viewport.
		if ('IntersectionObserver' in window) {
			var observer = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (entry) {
						if (entry.isIntersecting) {
							var firstLink = ctaRow.querySelector('a.cta-btn');
							fireImpression(firstLink ? firstLink.href : null);
							observer.disconnect();
						}
					});
				},
				{ threshold: 0.5 }
			);
			observer.observe(ctaRow);
		} else {
			// Fallback: fire immediately if IntersectionObserver unavailable.
			var firstLinkFallback = ctaRow.querySelector('a.cta-btn');
			fireImpression(firstLinkFallback ? firstLinkFallback.href : null);
		}

		// Click listener: fire cta_click before navigation, preserving utm_* params.
		ctaRow.addEventListener('click', function (event) {
			var anchor = event.target.closest('a');
			if (!anchor) return;
			try {
				window.sendBlogEvent('cta_click', Object.assign(
					{
						cta_id: 'hero_checkin_cta',
						landing_path: window.location.pathname,
						target_url: anchor.href,
					},
					window.__gqUtm || {}
				));
			} catch (e) {
				console.warn('[GentleQuest] hero cta_click failed:', e);
			}
		});
	})();

	// GentleQuest Task 8: App Store buttons UTM pass-through helper.
	// Reads window.__gqUtm set by BaseHead UTM parser and appends utm_* query params to store outbound links.
	(function () {
		function appendUtmToStoreLinks() {
			var utm = window.__gqUtm;
			if (!utm) return;
			var keys = ['utm_source', 'utm_medium', 'utm_campaign'];
			var hasUtm = false;
			for (var i = 0; i < keys.length; i++) {
				if (utm[keys[i]]) {
					hasUtm = true;
					break;
				}
			}
			if (!hasUtm) return;

			var storeLinks = document.querySelectorAll('a[href*="apps.apple.com"], a[href*="play.google.com"]');
			storeLinks.forEach(function (link) {
				try {
					var url = new URL(link.href);
					keys.forEach(function (k) {
						if (utm[k]) {
							url.searchParams.set(k, utm[k]);
						}
					});
					link.href = url.toString();
				} catch (e) {
					console.warn('[GentleQuest] store link UTM append failed:', e);
				}
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', appendUtmToStoreLinks);
		} else {
			appendUtmToStoreLinks();
		}
	})();
</script>

<style>
	.hero {
		text-align: center;
		padding: 4rem 1rem 3rem;
	}
	.hero h1 {
		font-size: clamp(2rem, 5vw, 3.5rem);
		margin: 0 0 1rem;
		line-height: 1.1;
	}
	.tagline {
		font-size: 1.2rem;
		color: rgb(var(--gray));
		max-width: 600px;
		margin: 0 auto 2rem;
		line-height: 1.5;
	}
	.cta-row {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		justify-content: center;
	}
	.secondary-ctas {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.cta-btn {
		display: inline-block;
		padding: 0.8rem 1.6rem;
		background: rgb(var(--accent));
		color: white;
		text-decoration: none;
		border-radius: 8px;
		font-weight: 600;
		transition: all 0.2s;
	}
	.cta-btn:hover {
		opacity: 0.9;
	}
	.secondary-btn {
		padding: 0.5rem 1rem;
		font-size: 0.85rem;
		font-weight: 500;
		background: transparent;
		color: rgb(var(--gray));
		border: 1px solid rgba(var(--gray), 0.4);
		border-radius: 6px;
	}
	.secondary-btn:hover {
		background: rgb(var(--gray-light));
		color: rgb(var(--black));
		opacity: 1;
	}
	.recent-posts {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem 1rem 4rem;
	}
	.recent-posts h2 {
		margin-bottom: 1.5rem;
	}
	.recent-posts ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.recent-posts li a {
		text-decoration: none;
		display: block;
		padding: 1rem;
		border-radius: 8px;
		transition: background 0.2s;
	}
	.recent-posts li a:hover {
		background: rgb(var(--gray-light));
	}
	.recent-posts .title {
		margin: 0 0 0.25rem;
		color: rgb(var(--black));
		font-size: 1.25rem;
	}
	.recent-posts .date {
		margin: 0 0 0.5rem;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.recent-posts .desc {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.see-all {
		display: block;
		margin-top: 2rem;
		text-align: center;
		text-decoration: none;
		color: rgb(var(--accent));
		font-weight: 600;
	}
	.empty {
		color: rgb(var(--gray));
		text-align: center;
		padding: 2rem;
	}
</style>
