---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Newsletter from '../components/Newsletter.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import AppCTA from '../components/AppCTA.astro';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, description, pubDate, updatedDate, heroImage, tags, slug } = Astro.props;

// Build the absolute image URL for structured data
const imageUrl = heroImage
	? new URL(heroImage.src, Astro.site).toString()
	: undefined;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate || pubDate).toISOString(),
	author: {
		'@type': 'Organization',
		name: 'GentleQuest',
		url: 'https://gentlequest.app',
	},
	publisher: {
		'@type': 'Organization',
		name: 'GentleQuest',
		url: 'https://gentlequest.app',
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': new URL(Astro.url.pathname, Astro.site).toString(),
	},
	...(imageUrl ? { image: imageUrl } : {}),
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: 'https://gentlequest.app/',
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Blog',
			item: 'https://gentlequest.app/blog/',
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: title,
			item: new URL(Astro.url.pathname, Astro.site).toString(),
		},
	],
};
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			ogType="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
		<meta name="robots" content="index,follow">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.breadcrumbs {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 1em auto;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.breadcrumbs a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.breadcrumbs a:hover {
				text-decoration: underline;
			}
			.breadcrumbs .sep {
				margin: 0 0.4em;
				color: rgb(var(--gray-light));
			}
			.breadcrumbs .current {
				color: rgb(var(--gray));
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		.share-buttons {
			display: flex;
			gap: 1em;
			justify-content: center;
			margin: 2em 0;
			padding: 1em 0;
			border-top: 1px solid rgb(var(--gray-light));
			border-bottom: 1px solid rgb(var(--gray-light));
		}
		.share-buttons a {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			padding: 0.75em 1.25em;
			border-radius: 6px;
			text-decoration: none;
			font-size: 0.9rem;
			font-weight: 500;
			color: rgb(var(--gray-dark));
			border: 1px solid rgb(var(--gray-light));
			transition: all 0.15s;
		}
		.share-buttons a:hover {
			background: rgb(var(--gray-light));
			color: rgb(var(--black));
		}
		.share-buttons .share-label {
			font-size: 0.85rem;
			color: rgb(var(--gray));
			margin-right: 0.5em;
		}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<nav class="breadcrumbs" aria-label="Breadcrumb">
					<a href="/">Home</a> <span class="sep">›</span>
					<a href="/blog/">Blog</a> <span class="sep">›</span>
					<span class="current">{title}</span>
				</nav>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				<div id="mid-cta-mount" style="display:none">
					<AppCTA variant="mid" />
				</div>
				<AppCTA variant="end" />
				<div class="share-buttons">
					<span class="share-label">Share:</span>
					<a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}&via=gentlequest_dev`} target="_blank" rel="noopener">Twitter</a>
					<a href={`https://www.reddit.com/submit?url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener">Reddit</a>
					<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener">LinkedIn</a>
					<a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + Astro.url.href)}`} target="_blank" rel="noopener">WhatsApp</a>
				</div>
				</div>
				<div class="prose">
					{slug && tags && <RelatedPosts currentSlug={slug} tags={tags} />}
					<Newsletter />
				</div>
			</article>
		</main>
		<Footer />
		<script is:inline>
			(function () {
				var mount = document.getElementById('mid-cta-mount');
				if (!mount) return;
				var prose = document.querySelector('.prose');
				if (!prose) { mount.style.display = ''; return; }

				// Prefer placing after the first <h2> in the article body.
				var h2 = prose.querySelector('h2');
				if (h2) {
					h2.parentNode.insertBefore(mount, h2.nextSibling);
				} else {
					// Fallback: insert after the 3rd top-level element inside .prose
					// (skipping .title and the first two content blocks from the slot).
					var children = prose.children;
					if (children.length >= 4) {
						prose.insertBefore(mount, children[3]);
					} else {
						// Article too short — just show it before the end CTA.
					}
				}
				mount.style.display = '';
				mount.removeAttribute('id');
			})();
		</script>
	</body>
</html>
