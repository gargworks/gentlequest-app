## Grunt Worker Script

### File: `scripts/grunt_worker.py`

```python
#!/usr/bin/env python3
"""
Grunt Worker - Background task execution via Gemini CLI

Usage:
    python grunt_worker.py run        # Process queue once
    python grunt_worker.py daemon     # Run continuously
    python grunt_worker.py add "task" # Add task to queue
"""

import subprocess
import json
import os
from pathlib import Path
from datetime import datetime, timezone

PROJECT_ROOT = Path(__file__).parent.parent
BRAIN_PATH = PROJECT_ROOT / ".brain"
QUEUE_FILE = BRAIN_PATH / "ledger" / "grunt_queue.json"
OUTPUT_DIR = BRAIN_PATH / "artifacts" / "grunt"

def load_queue():
    if QUEUE_FILE.exists():
        return json.loads(QUEUE_FILE.read_text())
    return {"tasks": [], "stats": {...}}

def save_queue(queue):
    QUEUE_FILE.write_text(json.dumps(queue, indent=2))

def run_gemini_cli(task, context_files, model):
    """Execute Gemini CLI with context files."""
    cmd = ["gemini", "-m", model]
    
    for cf in context_files:
        path = PROJECT_ROOT / cf
        if path.exists():
            cmd.extend(["--file", str(path)])
    
    # Add the task as prompt
    prompt = f"""
You are a code assistant. Complete this task:

{task['description']}

Output only the code/content, no explanations.
"""
    
    result = subprocess.run(
        cmd,
        input=prompt,
        capture_output=True,
        text=True,
        timeout=300  # 5 min max
    )
    
    return result.stdout, result.stderr, result.returncode

def process_task(task, queue):
    """Process a single task."""
    task_type = classify_task(task['description'])
    context_files = get_context_files(task_type, task.get('context_files', []))
    model = get_model()
    
    task['status'] = 'running'
    save_queue(queue)
    
    stdout, stderr, code = run_gemini_cli(task, context_files, model)
    
    if code == 0 and stdout:
        # Save output
        output_file = OUTPUT_DIR / f"{task['id']}.md"
        output_file.parent.mkdir(parents=True, exist_ok=True)
        output_file.write_text(f"# {task['description']}\n\n{stdout}")
        
        task['status'] = 'completed'
        task['output_path'] = str(output_file.relative_to(PROJECT_ROOT))
        queue['stats']['total_completed'] += 1
        
        # Notify via Telegram
        send_telegram(f"✅ Grunt task completed: {task['description'][:50]}")
    else:
        if is_rate_limited(stderr):
            if not handle_rate_limit():
                task['status'] = 'failed'
                task['error'] = 'All models rate limited'
                send_telegram("⚠️ Grunt worker paused: Rate limit reached")
        else:
            task['status'] = 'failed'
            task['error'] = stderr[:200]
        
        queue['stats']['total_failed'] += 1
    
    save_queue(queue)
    return task['status'] == 'completed'

def daemon():
    """Run continuously, processing tasks."""
    while True:
        queue = load_queue()
        pending = [t for t in queue['tasks'] if t['status'] == 'pending']
        
        if pending:
            task = pending[0]  # FIFO
            process_task(task, queue)
        
        time.sleep(30)  # Poll every 30 sec
```

