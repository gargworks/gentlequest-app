## Telegram Integration

### New Command: `/grunt`

```python
# In brain_telegram.py

def handle_grunt_command(task_description: str) -> str:
    """Handle /grunt <task description> command."""
    if not task_description:
        return "❌ Usage: /grunt Create mood chart widget"
    
    # Add to queue
    queue = load_grunt_queue()
    task_id = f"grunt-{uuid.uuid4().hex[:8]}"
    
    task = {
        "id": task_id,
        "created": datetime.now(timezone.utc).isoformat(),
        "status": "pending",
        "type": classify_task(task_description),
        "description": task_description,
        "context_files": [],
        "priority": 1,
        "output_path": None,
        "error": None
    }
    
    queue['tasks'].append(task)
    save_grunt_queue(queue)
    
    return f"""🔧 Grunt task queued!

ID: `{task_id}`
Type: {task['type']}
Task: {task_description[:50]}

Will be processed when grunt worker is running."""
```

