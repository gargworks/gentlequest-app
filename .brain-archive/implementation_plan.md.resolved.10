## Gemini Model Selection

### Model Priority (Premium First)

```python
MODELS = [
    "gemini-2.0-flash-exp",      # Best, experimental
    "gemini-1.5-pro-latest",     # Fallback, very capable
    "gemini-1.5-flash-latest",   # Fast fallback
]

# Start with best model
current_model_index = 0

def get_model():
    return MODELS[current_model_index]

def handle_rate_limit():
    global current_model_index
    if current_model_index < len(MODELS) - 1:
        current_model_index += 1
        return True  # Try next model
    return False  # All models rate limited, stop
```

### Rate Limit Detection

```python
def is_rate_limited(response) -> bool:
    return "429" in str(response) or "quota" in str(response).lower()
```

---

## Queue Structure (GitHub API)

Instead of a local JSON file, we use `gh` CLI or `requests` to manage issues.

- **New Task**: `gh issue create --title "Grunt: <Task>" --body "<Details>" --label "grunt-work"`
- **Poll**: `gh issue list --label "grunt-work" --state open --json number,title,body`
- **Complete**: `gh issue comment <id> --body "✅ Result..."` and `gh issue close <id>`

---

## Grunt Worker Script

### File: `scripts/grunt_worker.py`

```python
#!/usr/bin/env python3
"""
Grunt Worker - Background task execution via Gemini CLI & GitHub Issues

Usage:
    python grunt_worker.py daemon     # Run continuously
"""

import subprocess
import time
import os
from pathlib import Path

# ... (Context & Classification logic same as above) ...

def get_pending_tasks():
    """Get open issues with label 'grunt-work' via gh CLI."""
    cmd = ["gh", "issue", "list", "--label", "grunt-work", "--state", "open", "--json", "number,title,body"]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode == 0:
        return json.loads(result.stdout)
    return []

def post_comment(issue_number, body):
    subprocess.run(["gh", "issue", "comment", str(issue_number), "--body", body])

def close_issue(issue_number):
    subprocess.run(["gh", "issue", "close", str(issue_number)])

def process_task(task):
    """Process a single GitHub issue task."""
    print(f"⚙️ Processing issue #{task['number']}: {task['title']}")
    
    # Notify start
    post_comment(task['number'], "🤖 Gemini Grunt Worker engaged. Analyzing...")
    
    task_desc = f"{task['title']}\n{task['body']}"
    task_type = classify_task(task_desc)
    context_files = get_context_files(task_type, [])
    model = get_model()
    
    stdout, stderr, code = run_gemini_cli({'description': task_desc}, context_files, model)
    
    if code == 0 and stdout:
        # Post result
        result_msg = f"## ✅ Task Completed\n\n**Type:** {task_type}\n**Model:** {model}\n\n### Output\n\n```\n{stdout}\n```"
        post_comment(task['number'], result_msg)
        close_issue(task['number'])
        print(f"✅ Completed #{task['number']}")
    else:
        # Report error
        error_msg = f"## ❌ Task Failed\n\nError: {stderr[:500]}"
        post_comment(task['number'], error_msg)
        print(f"❌ Failed #{task['number']}")

def daemon():
    print("🤖 Grunt Worker Daemon Started (Polling GitHub Issues)...")
    while True:
        try:
            tasks = get_pending_tasks()
            for task in tasks:
                process_task(task)
        except Exception as e:
            print(f"⚠️ Error polling: {e}")
        
        time.sleep(60)  # Poll every minute
```

