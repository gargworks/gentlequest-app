**Load prompts from files:**
```python
def _load_agent_prompt(self, persona_name: str) -> str:
    agent_file = BRAIN_PATH / "agents" / f"{persona_name.lower()}.md"
    if agent_file.exists():
        # Extract IDENTITY and CORE FUNCTIONS sections
        return self._extract_prompt_sections(agent_file.read_text())
    return None
```

