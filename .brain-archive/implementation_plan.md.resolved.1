### Implementation

**File:** `scripts/telegram_bot.py`

```python
#!/usr/bin/env python3
"""
PEFS Telegram Bot
Sends daily briefings and commitment reminders
"""

import os
from telegram import Bot, Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes
import json
from pathlib import Path
from datetime import datetime

BRAIN_PATH = Path(os.getenv("NUCLEAR_BRAIN_PATH", "/Users/lokeshgarg/ai-mvp-backend/.brain"))
BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")  # Your personal chat ID

def load_commitment_ledger():
    ledger_path = BRAIN_PATH / "commitments" / "ledger.json"
    if ledger_path.exists():
        return json.loads(ledger_path.read_text())
    return {"commitments": [], "stats": {}}

async def send_daily_briefing():
    """Send morning briefing with open commitments"""
    bot = Bot(token=BOT_TOKEN)
    ledger = load_commitment_ledger()
    
    open_comms = [c for c in ledger["commitments"] if c["status"] == "open"]
    red_tier = [c for c in open_comms if c["tier"] == "red"]
    
    if not open_comms:
        message = "☀️ Good morning, Chairman!\n\n✅ Zero open loops. Enjoy your guilt-free day!"
        await bot.send_message(chat_id=CHAT_ID, text=message)
        return
    
    # Build message
    message = f"""☀️ Good morning, Chairman!

🎯 TODAY'S CRITICAL PATH:
• {ledger['stats']['red_tier']} commitment(s) need closure (aging >7 days)
• {ledger['stats']['total_open']} total open loops

🧠 BRAIN HEALTH:
• Mental load estimate: {"HIGH" if red_tier else "MEDIUM" if ledger['stats']['yellow_tier'] > 2 else "LOW"}
"""
    
    if red_tier:
        message += "\n🚨 RED TIER (needs attention):\n"
        for comm in red_tier[:3]:  # Show max 3
            message += f"• {comm['description']} ({comm['age_days']} days)\n"
    
    # Add buttons
    keyboard = [
        [InlineKeyboardButton("🔍 View All", callback_data="view_all")],
        [InlineKeyboardButton("⚡ Quick Close Session", callback_data="quick_close")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await bot.send_message(chat_id=CHAT_ID, text=message, reply_markup=reply_markup)

async def handle_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Handle button clicks"""
    query = update.callback_query
    await query.answer()
    
    if query.data == "view_all":
        ledger = load_commitment_ledger()
        open_comms = [c for c in ledger["commitments"] if c["status"] == "open"]
        
        message = "📋 ALL OPEN COMMITMENTS:\n\n"
        for comm in open_comms:
            tier_emoji = {"green": "🟢", "yellow": "🟡", "red": "🔴"}[comm["tier"]]
            message += f"{tier_emoji} {comm['description']} ({comm['age_days']}d)\n"
        
        await query.edit_message_text(text=message)
    
    elif query.data == "quick_close":
        message = "Opening your closure worksheet...\n\nCheck: SCHEDULED_ACTIONS.md"
        await query.edit_message_text(text=message)

if __name__ == "__main__":
    # For manual testing
    import asyncio
    asyncio.run(send_daily_briefing())
```

