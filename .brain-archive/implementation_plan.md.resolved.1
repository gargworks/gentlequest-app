### Implementation

**Core functions to add to `mcp-server-nucleus`:**

```python
def _get_commitment_ledger_path():
    return BRAIN_PATH / "commitments" / "ledger.json"

def _load_commitment_ledger():
    path = _get_commitment_ledger_path()
    if path.exists():
        return json.loads(path.read_text())
    return {"commitments": [], "last_scan": None, "stats": {}}

def _save_commitment_ledger(ledger):
    path = _get_commitment_ledger_path()
    path.parent.mkdir(exist_ok=True)
    path.write_text(json.dumps(ledger, indent=2))

def _add_commitment(source_file, source_line, description, type):
    ledger = _load_commitment_ledger()
    comm_id = f"comm_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
    
    commitment = {
        "id": comm_id,
        "created": datetime.now().isoformat(),
        "source_file": source_file,
        "source_line": source_line,
        "type": type,
        "description": description,
        "context": _analyze_context(description, source_file),
        "age_days": 0,
        "tier": "green",
        "suggested_action": None,
        "suggested_reason": None,
        "status": "open",
        "closed_at": None,
        "closed_method": None
    }
    
    ledger["commitments"].append(commitment)
    _save_commitment_ledger(ledger)
    return commitment

def _analyze_context(description, source_file):
    """AI-powered context analysis"""
    # Check for keywords
    desc_lower = description.lower()
    
    # Novelty
    if "first time" in desc_lower or "new" in desc_lower:
        novelty = "high"
    elif "repeat" in desc_lower or "again" in desc_lower:
        novelty = "low"
    else:
        novelty = "medium"
    
    # Dopamine (boring tasks)
    boring_keywords = ["fix", "bug", "setup", "config", "admin"]
    if any(k in desc_lower for k in boring_keywords):
        dopamine = "low"
    elif "build" in desc_lower or "create" in desc_lower:
        dopamine = "high"
    else:
        dopamine = "medium"
    
    # Urgency
    urgency = None
    if "deadline" in desc_lower or "urgent" in desc_lower:
        urgency = "high"
    
    return {
        "novelty": novelty,
        "dopamine": dopamine,
        "urgency": urgency,
        "emotional_load": 5  # default
    }

def _update_commitment_ages():
    """Update age and tier for all open commitments"""
    ledger = _load_commitment_ledger()
    
    for comm in ledger["commitments"]:
        if comm["status"] == "open":
            created = datetime.fromisoformat(comm["created"])
            comm["age_days"] = (datetime.now() - created).days
            
            # Tier logic
            if comm["age_days"] < 3:
                comm["tier"] = "green"
            elif comm["age_days"] < 7:
                comm["tier"] = "yellow"
            else:
                comm["tier"] = "red"
            
            # Suggested action
            if comm["context"]["dopamine"] == "low" and comm["age_days"] < 7:
                comm["suggested_action"] = "schedule"
                comm["suggested_reason"] = "Low dopamine task, schedule for morning"
            elif comm["context"]["novelty"] == "high":
                comm["suggested_action"] = "schedule"
                comm["suggested_reason"] = "High novelty, needs Chairman attention"
            elif comm["age_days"] > 30:
                comm["suggested_action"] = "archive"
                comm["suggested_reason"] = f"Stale ({comm['age_days']} days old)"
    
    # Update stats
    ledger["stats"] = {
        "total_open": len([c for c in ledger["commitments"] if c["status"] == "open"]),
        "green_tier": len([c for c in ledger["commitments"] if c["status"] == "open" and c["tier"] == "green"]),
        "yellow_tier": len([c for c in ledger["commitments"] if c["status"] == "open" and c["tier"] == "yellow"]),
        "red_tier": len([c for c in ledger["commitments"] if c["status"] == "open" and c["tier"] == "red"])
    }
    
    _save_commitment_ledger(ledger)
    return ledger
```

