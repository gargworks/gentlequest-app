    {
      "@type": "Question",
      "name": "What does the DASS-21 measure?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The DASS-21 is a 21-item questionnaire that measures three related negative emotional states: depression, anxiety, and stress."
      }
    },
    {
      "@type": "Question",
      "name": "How is the DASS-21 scored?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Each of the three subscales (depression, anxiety, stress) has seven items scored 0-3. Subscale scores are doubled and compared to cutoff ranges from normal to extremely severe."
      }
    },
    {
      "@type": "Question",
      "name": "Is the DASS-21 a diagnosis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, the DASS-21 screens for symptom severity across three domains but does not diagnose any condition. Results should be discussed with a healthcare professional."
      }
    },
    {
      "@type": "Question",
      "name": "How often should I take the DASS-21?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Taking it every two to four weeks allows you to track trends in depression, anxiety, and stress over time rather than relying on a single snapshot."
      }
    }
  ]
