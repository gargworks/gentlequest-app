# GentleQuest Environment Variables
# Copy to .env and fill in your values

# Environment
ENVIRONMENT=local  # local, docker, production

# Database
DATABASE_URL=postgresql://ai_buddy:ai_buddy_password@localhost:5432/mental_health

# Redis (optional, can use filesystem sessions)
REDIS_URL=redis://localhost:6379

# AI Providers (at least one required)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
PPLX_API_KEY=your_perplexity_api_key_here
AI_PROVIDER=gemini  # gemini, openai, perplexity

# Security
SECRET_KEY=your_secret_key_minimum_32_characters_long
ADMIN_API_TOKEN=your_admin_token_for_protected_endpoints

# Email Alerts (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=alerts@gentlequest.com

# SMS Alerts (Twilio - optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Data Retention (days)
MESSAGE_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=14
ERROR_LOG_RETENTION_DAYS=14
ANALYTICS_RETENTION_DAYS=90

# Features
ENABLE_FUNCTION_CALLING=true
ENABLE_MEMORY=true
ENABLE_PGVECTOR=true
COMMUNITY_ENABLED=true

# Monitoring (optional)
SENTRY_DSN_BACKEND=your_sentry_dsn_for_backend
SENTRY_DSN_FRONTEND=your_sentry_dsn_for_frontend
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telegram (optional, for Nuclear Brain integration)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
