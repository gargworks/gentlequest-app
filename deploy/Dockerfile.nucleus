# deploy/Dockerfile.nucleus
# Cloud Run Container for Nucleus Daemon

FROM python:3.11-slim

# Set env vars
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100 \
    PORT=8080

# Create app directory
WORKDIR /app

# Copy the package source
# We assume the build context is the project root
COPY mcp-server-nucleus /app/mcp-server-nucleus

# Install the package
WORKDIR /app/mcp-server-nucleus
RUN pip install .

# Create a non-root user
RUN adduser --disabled-password --gecos '' nucleus && \
    chown -R nucleus:nucleus /app
USER nucleus

# Expose the port
EXPOSE 8080

# Run the server
# Adjust the command based on how the server is actually started.
# If it's `python -m mcp_server_nucleus`, use that.
CMD ["python", "-m", "mcp_server_nucleus"]
